# Copy this file to backend/.env and fill in your own values:
#
#     cp backend/.env.example backend/.env
#
# backend/.env is git-ignored — never commit real credentials.
#
# Everything here is read by app/config.py, which prefixes every field with
# IGEM_. The ETL (etl/config.py) reads the same IGEM_DB_* names, but straight
# from the process environment — it does NOT load this file. So when running
# the ETL, export them in your shell as well.

# --- MySQL (required) -------------------------------------------------------
# The backend connects asynchronously (mysql+aiomysql); the ETL connects
# synchronously (mysql+pymysql). Both need these five values.
IGEM_DB_HOST=localhost
IGEM_DB_PORT=3306
IGEM_DB_USER=root
IGEM_DB_PASSWORD=
IGEM_DB_NAME=igem_terpene

# --- NCBI BLAST+ (optional) -------------------------------------------------
# Directory holding the BLAST+ executables. Leave the default if you unpacked
# BLAST+ into ./blast_bin; set it to an empty value to fall back to your
# system PATH. See docs/wiki/database-protocol.md §3.4.
IGEM_BLAST_BIN_DIR=blast_bin
# Working directory for BLAST+ subject files. Its final path must be ASCII-only
# — BLAST+'s LMDB files cannot be written under a non-ASCII directory, and the
# service silently falls back to the system temp dir when that happens.
IGEM_BLAST_WORK_DIR=blast_work

# --- Database assistant (optional) -----------------------------------------
# Without a key, the assistant still answers from database records and links.
# With a key, it can summarize retrieved facts in natural language.
# IGEM_ASSISTANT_API_KEY=
# IGEM_ASSISTANT_MODEL=gpt-4.1-mini

# --- ETL only (not read by the backend) -------------------------------------
# Point the ETL at a different for_*/ tree, e.g. a sandbox, instead of the
# repository root. Read by etl/config.py.
# IGEM_DATA_DIR=
